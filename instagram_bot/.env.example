# OpenRouter API key for AI comment generation and niche classification
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Instagram credentials (used when session cookies are missing or expired)
INSTAGRAM_USER=your_instagram_username
INSTAGRAM_PASS=your_instagram_password

# Set to false for mobile layout; true (default) may fix "trouble playing this video"
# USE_DESKTOP_VIEW=true
